# remove.bg API Key（必填，仅服务端，绝不以 NEXT_PUBLIC_ 前缀暴露）
REMOVE_BG_API_KEY=your_key_here

# Provider 选择（默认 removebg）
PROVIDER=removebg

# 并发控制（remove.bg 免费档低并发）
MAX_CONCURRENCY=2

# Provider 超时时间（毫秒）
PROVIDER_TIMEOUT_MS=30000

# 允许的最大文件大小（MB）—— Vercel 部署必须 ≤4，自托管可用 10
ALLOWED_MAX_MB=4

# 允许的文件类型
ALLOWED_TYPES=image/jpeg,image/png,image/webp
