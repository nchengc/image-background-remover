{
  "name": "bg-remover",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "极简图片去背景网站：React + Vite 前端 + Cloudflare Pages Functions 同源代理（remove.bg）",
  "scripts": {
    "dev": "vite",
    "dev:functions": "wrangler pages dev -- npm run dev",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "pages:preview": "npm run build && wrangler pages dev dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^15.0.7",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^1.6.1",
    "autoprefixer": "^10.4.19",
    "jsdom": "^24.1.3",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.6",
    "typescript": "~5.4.5",
    "vite": "^5.3.4",
    "vitest": "^1.6.1",
    "wrangler": "^3.65.0"
  },
  "engines": {
    "node": ">=18.17.0"
  }
}
